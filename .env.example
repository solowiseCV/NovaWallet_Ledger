# Copy this file to .env and replace every placeholder with a unique local value.
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<strong-local-database-password>
JWT_ISSUER=<jwt-issuer>
JWT_AUDIENCE=<jwt-audience>
# Use a cryptographically random value of at least 32 characters. Do not reuse this in production.
JWT_SIGNING_KEY=<at-least-32-character-random-signing-key>
